# Test environment example — copy to .env.test and fill in values
# This file is safe to commit. .env.test is gitignored.
SECRET_KEY=test-secret-key-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
PYTHONPATH=/app

# Test database (ephemeral — spun up by docker-compose.test.yml)
DATABASE_URL=postgresql+asyncpg://test:test@postgres:5432/cycloveda_test

# Strava — dummy values, tests mock all external Strava API calls
STRAVA_CLIENT_ID=test_client_id
STRAVA_CLIENT_SECRET=test_client_secret
STRAVA_REDIRECT_URI=http://localhost/api/strava/callback
STRAVA_STATE_SALT=test_state_salt_for_hmac

# Fernet key — must be a valid URL-safe base64-encoded 32-byte key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRAVA_ENCRYPTION_KEY=your_fernet_base64_key_here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Postgres credentials (must match docker-compose.test.yml postgres service)
POSTGRES_DB=cycloveda_test
POSTGRES_USER=test
POSTGRES_PASSWORD=test
